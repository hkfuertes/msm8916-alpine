# Default profile — baseline values for all builds.
# Override per-appliance in profiles/<name>.env, or locally in variables.env (gitignored).

HOST_NAME="uz801a"
USERNAME="user"

WIFI_ENABLED="yes"
WIFI_SSID=""
WIFI_PASS=""
WIFI_IP=""      # Optional static WiFi IPv4 CIDR, e.g. "192.168.1.50/24"; empty = DHCP
WIFI_GW=""      # Optional gateway for WIFI_IP
WIFI_DNS=""     # Optional DNS for WIFI_IP, e.g. "1.1.1.1;8.8.8.8;"

DTB_FILE="msm8916-yiming-uz801v3.dtb"
USB0_IP="192.168.42.1/24"
USB0_GW=""
USB0_DNS=""
USB_GADGET_INSTALL="yes"
USB_GADGET_OTG="no"
USB_GADGET_ENABLED="yes"

OCTOPRINT_PREINSTALL="no"
ZORAXY_PREINSTALL="no"
DOCKER_ENABLE="no"
STACKS=""

# Profile-specific additions (separated from base packages/services)
PROFILE_PACKAGES=""
PROFILE_SERVICES=""

RELEASE="v3.24"
PMOS_RELEASE="v26.06"
MIRROR="http://dl-cdn.alpinelinux.org/alpine"
PMOS_MIRROR="http://mirror.postmarketos.org/postmarketos"
